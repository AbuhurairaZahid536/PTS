NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pts_farooqabad
DB_CONNECTION_LIMIT=10

# Generate a long random secret. Do not commit the real value.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h

# ZKBioTime integration account and server address.
ZKBIO_BASE_URL=http://127.0.0.1:80
ZKBIO_USERNAME=admin
ZKBIO_PASSWORD=change_me

# Optional: visitor suggestion acknowledgement by Resend REST API.
# Requires a VERIFIED SENDER DOMAIN. Never commit real secrets to Git.
# Without these values, suggestions and in-portal bell still work;
# email_status becomes NOT_CONFIGURED (no false delivery confirmation).
RESEND_API_KEY=
PUBLIC_SUGGESTION_FROM_EMAIL=

# Server-side BioTime pull sync (independent of browser sessions).
BIOMETRIC_AUTO_SYNC_ENABLED=true
BIOMETRIC_AUTO_SYNC_SECONDS=60
